{
  "name": "my_vuepress_blog",
  "version": "VuePress 2.0 rc.30",
  "description": "Lxy's vuepress blog",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "i": "yarn run inst",
    "inst": "yarn --non-interactive ",
    "chk": "oxfmt --check",
    "fix": "oxfmt",
    "postinstall": "patch-package",
    "dev": "vuepress dev docs",
    "build": "vuepress build docs",
    "updatepkg": "npx vp-update",
    "up": "yarn upgrade --non-interactive -p (!Vuepress,!@Vuepress/bundler-vite,!oxfmt)",
    "vuepress": "vuepress",
    "gitsync": "git pull --rebase origin master",
    "gitadd": "git add -A",
    "gitcommit": "git diff --cached --quiet && echo 无改动跳过commit || git commit",
    "gitpush": "git push -u origin master",
    "verceldeploy": "vercel --prod",
    "deploy": "yarn gitadd && yarn gitcommit && yarn gitsync && yarn gitpush"
  },
  "dependencies": {
    "@vercel/blob": "^2.7.0",
    "cross-env": "^10.0.0",
    "element-plus": "^2.7.4",
    "vuepress-theme-hope": "2.0.0-rc.107"
  },
