    "moment": "^2.30.1",
    "node-fetch": "^3.3.2",
    "oxfmt": "0.63.0",
    "patch-package": "^8.0.1",
    "sass": "^1.101.0",
    "unpipe": "^1.0.0",
    "update-browserslist-db": "^1.1.3",
    "vidstack": "^1.12.13",
